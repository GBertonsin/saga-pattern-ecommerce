@startuml saga-architecture-overview
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 12
skinparam ArrowColor #555555
skinparam ArrowThickness 1.3
skinparam nodesep 40
skinparam ranksep 70
skinparam rectangle {
  BorderColor #607D8B
}
skinparam database {
  BackgroundColor #FAFAFA
  BorderColor #607D8B
}
skinparam queue {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}

title Visão Geral — Saga Orquestrada de Pedido

actor "Cliente" as client
rectangle "API Gateway" as gw #ECEFF1

rectangle "**Order Service**\n\nOrquestrador da Saga" as order #BBDEFB
database "Order DB" as odb

queue "**Apache Kafka**\n\ncomandos · respostas · eventos" as kafka

rectangle "**Inventory Service**" as inv #C8E6C9
database "Inventory DB" as idb

rectangle "**Payment Service**\n\nRetry + Circuit Breaker" as pay #FFE0B2
database "Payment DB" as pdb

rectangle "Gateway de\nPagamento (PSP)" as psp #ECEFF1

client --> gw : HTTPS
gw --> order : POST /orders
order --> odb
order <--> kafka : comandos /\nrespostas
kafka <--> inv
kafka <--> pay
inv --> idb
pay --> pdb
pay --> psp : HTTPS

note bottom of kafka
  Mensagens de erro após N tentativas
  vão para **Dead-Letter Topics**
end note

note bottom of order
  Estado da Saga na tabela
  **saga_instance** + **outbox**
end note
@enduml
