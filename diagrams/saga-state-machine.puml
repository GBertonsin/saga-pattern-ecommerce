@startuml saga-state-machine
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam state {
  BackgroundColor #E3F2FD
  BorderColor #607D8B
  ArrowColor #424242
}
hide empty description

title Estados da Saga

[*] --> RESERVANDO_ESTOQUE
RESERVANDO_ESTOQUE --> AUTORIZANDO_PAGAMENTO : estoque ok
RESERVANDO_ESTOQUE --> CANCELANDO_PEDIDO : sem estoque

AUTORIZANDO_PAGAMENTO --> APROVANDO_PEDIDO : pago
AUTORIZANDO_PAGAMENTO --> LIBERANDO_ESTOQUE : recusado / timeout

LIBERANDO_ESTOQUE --> CANCELANDO_PEDIDO
CANCELANDO_PEDIDO --> CANCELADO
APROVANDO_PEDIDO --> APROVADO

APROVADO --> [*]
CANCELADO --> [*]

state LIBERANDO_ESTOQUE #FFEBEE
state CANCELANDO_PEDIDO #FFEBEE
state APROVADO #C8E6C9
state CANCELADO #FFCCBC

legend bottom
  Rosa = compensação
endlegend
@enduml
