@startuml saga-state-machine
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam state {
  BackgroundColor #F5F9FF
  BorderColor #4A6FA5
  ArrowColor #333333
}

title Máquina de Estados do Orquestrador (tabela saga_instance)

[*] --> STARTED : POST /orders\n(order PENDING)
STARTED --> RESERVING_STOCK : envia ReserveStock
RESERVING_STOCK --> AUTHORIZING_PAYMENT : StockReserved
RESERVING_STOCK --> CANCELLING_ORDER : StockUnavailable
RESERVING_STOCK --> RESERVING_STOCK : timeout → reenvia\n(mesmo messageId)

AUTHORIZING_PAYMENT --> CONFIRMING_STOCK : PaymentAuthorized\n(ponto de não retorno)
AUTHORIZING_PAYMENT --> RELEASING_STOCK : PaymentDeclined
AUTHORIZING_PAYMENT --> AUTHORIZING_PAYMENT : timeout → reenvia /\nconsulta status no PSP
AUTHORIZING_PAYMENT --> REFUNDING_PAYMENT : resultado desconhecido\napós max_retries

REFUNDING_PAYMENT --> RELEASING_STOCK : PaymentRefunded
RELEASING_STOCK --> CANCELLING_ORDER : StockReleased
CANCELLING_ORDER --> COMPENSATED : order CANCELLED

CONFIRMING_STOCK --> APPROVING_ORDER : ReservationConfirmed
CONFIRMING_STOCK --> CONFIRMING_STOCK : falha técnica → retry
APPROVING_ORDER --> COMPLETED : order APPROVED

COMPLETED --> [*]
COMPENSATED --> [*]

RELEASING_STOCK --> FAILED_NEEDS_ATTENTION : retries esgotados\n(mensagem em DLT)
REFUNDING_PAYMENT --> FAILED_NEEDS_ATTENTION : retries esgotados
CONFIRMING_STOCK --> FAILED_NEEDS_ATTENTION : retries esgotados
FAILED_NEEDS_ATTENTION --> [*] : intervenção manual\n(reprocessar DLT)

state COMPLETED #C8E6C9
state COMPENSATED #FFE0B2
state FAILED_NEEDS_ATTENTION #FFCDD2
state REFUNDING_PAYMENT #FFEBEE : compensação de T3
state RELEASING_STOCK #FFEBEE : compensação de T2
state CANCELLING_ORDER #FFEBEE : compensação de T1

legend bottom
  Estados em <back:#FFEBEE>rosa</back> = transações compensatórias (ordem inversa)
  Estados retriáveis (após o pivô) nunca voltam para compensação
endlegend
@enduml
