@startuml sequence-success-flow
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ParticipantPadding 25
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor #424242
  LifeLineBorderColor #9E9E9E
  ParticipantBorderColor #607D8B
  GroupBorderColor #90A4AE
}
hide footbox

title Fluxo de Sucesso

actor Cliente as C
participant "Order Service\n(Orquestrador)" as O #BBDEFB
participant "Inventory\nService" as I #C8E6C9
participant "Payment\nService" as P #FFE0B2
participant "Gateway\n(PSP)" as G #ECEFF1

autonumber

C -> O : POST /orders
O -> O : cria pedido **PENDING**
O --> C : 202 Accepted

O ->> I : ReserveStock
I -> I : reserva estoque
I -->> O : StockReserved

O ->> P : AuthorizePayment
P -> G : cobrança
G --> P : aprovada
P -->> O : PaymentAuthorized

O ->> I : ConfirmReservation
I -->> O : ReservationConfirmed

O -> O : pedido **APPROVED**
O -->> C : notificação "Pedido aprovado"

legend right
  **->**  síncrono (HTTP)
  **->>**  assíncrono (Kafka)
endlegend
@enduml
